{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreIssues": {
    "pnpm-workspace.yaml": ["catalog"]
  },
  "workspaces": {
    ".": {
      "entry": ["vite.config.ts"]
    },
    "packages/core": {
      "entry": ["src/index.ts", "vite.config.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/tui": {
      "entry": [
        "src/index.ts",
        "src/cli.tsx",
        "vite.config.ts",
        "tests/**/*.test.ts",
        "tests/**/*.test.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    }
  }
}
